{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:job:1",
  "title": "job",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "hypothesis_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notebook_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lease_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "seconds",
        "memory_bytes",
        "cpu_cores",
        "pids",
        "output_bytes",
        "artifact_bytes"
      ]
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "attempt_id",
    "campaign_id",
    "hypothesis_digest",
    "candidate_digest",
    "environment_digest",
    "public_input_digest",
    "notebook_snapshot",
    "execution_policy_digest",
    "lease_id",
    "lease_expires_at",
    "seed",
    "limits"
  ]
}
