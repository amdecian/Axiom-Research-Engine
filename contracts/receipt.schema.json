{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:receipt:1",
  "title": "receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_commitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "finite_pass",
        "counterexample",
        "inconclusive",
        "timeout",
        "cancelled",
        "error",
        "formal_checked"
      ]
    },
    "checks_passed": {
      "type": "integer",
      "minimum": 0
    },
    "checks_total": {
      "type": "integer",
      "minimum": 0
    },
    "counterexample_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_statement_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "cpu_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "peak_rss_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "operation_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_integer_bits": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "wall_ns",
        "cpu_ns",
        "peak_rss_bytes",
        "operation_count",
        "max_integer_bits"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "attempt_id",
    "job_id",
    "candidate_digest",
    "environment_digest",
    "verifier_digest",
    "fixture_commitment",
    "output_digest",
    "verdict",
    "checks_passed",
    "checks_total",
    "counterexample_digest",
    "proof_statement_digest",
    "metrics",
    "created_at",
    "signer_id",
    "signature"
  ]
}
