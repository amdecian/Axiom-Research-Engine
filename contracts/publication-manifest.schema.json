{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline disclosure manifest — private metadata, never publish a real instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "source_repository",
    "source_commit",
    "target_repository",
    "public_base_commit",
    "reviews",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "publication-1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^PUB-[0-9]{6}$"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_repository": {
      "const": "amdecian/Axiom-Research-Engine"
    },
    "public_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights",
        "scientific",
        "security",
        "owner"
      ],
      "properties": {
        "rights": {
          "const": true
        },
        "scientific": {
          "const": true
        },
        "security": {
          "const": true
        },
        "owner": {
          "const": true
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "classification"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "classification": {
            "const": "approved_public"
          }
        }
      }
    }
  }
}
