{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Planned provider proposal (NOT runtime-enabled)","type":"object","additionalProperties":false,"required":["schema_version","evidence_snapshot_sha256","evidence_refs","hypothesis","strategy","falsification_test"],"properties":{"schema_version":{"const":"proposal-1"},"evidence_snapshot_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"evidence_refs":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"hypothesis":{"type":"string","minLength":1,"maxLength":2000},"strategy":{"$ref":"sat-strategy.schema.json"},"falsification_test":{"type":"string","minLength":1,"maxLength":2000}},"$comment":"Future broker must validate references against exact read-only snapshot; no free text is executable or proof."}
