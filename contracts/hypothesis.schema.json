{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:hypothesis:1",
  "title": "hypothesis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "hypothesis_id": {
      "type": "string",
      "format": "uuid"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    },
    "falsification_plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cost_claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "hypothesis_id",
    "campaign_id",
    "statement",
    "scope",
    "assumptions",
    "techniques",
    "evidence_ids",
    "falsification_plan",
    "cost_claim",
    "candidate_digest",
    "parent_attempt_ids"
  ]
}
