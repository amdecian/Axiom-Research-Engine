{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiom:contract:campaign:1",
  "title": "campaign",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "campaign_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "baseline_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_fixture_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "holdout_commitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notebook_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objective": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "provider_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "attempts",
        "candidate_seconds",
        "aggregate_seconds",
        "cpu_cores",
        "memory_bytes",
        "pids",
        "output_bytes",
        "artifact_bytes",
        "provider_micro_usd",
        "model_calls",
        "model_tokens"
      ]
    },
    "provider_enabled": {
      "type": "boolean"
    },
    "provider_policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "project_id",
    "adapter_id",
    "adapter_version",
    "brief",
    "scope",
    "baseline_digest",
    "public_fixture_digest",
    "holdout_commitment",
    "notebook_snapshot",
    "objective",
    "seed",
    "budget",
    "provider_enabled",
    "provider_policy_digest",
    "execution_policy_digest",
    "stop_conditions"
  ]
}
